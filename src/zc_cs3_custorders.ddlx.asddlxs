@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'Orderid'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'Customerid'
annotate view ZC_CS3_CUSTORDERS with
{
  @UI.facet: [ {
    label: 'Allgemeine Informationen',
    id: 'GeneralInfo',
    purpose: #STANDARD,
    position: 10,
    type: #IDENTIFICATION_REFERENCE
  } ]

  @UI.identification: [ {
    position: 10
  } ]
  @UI.lineItem: [ {
    position: 10
  } ]
  @UI.selectionField: [ {
    position: 10
  } ]
  Customerid;

  @UI.identification: [ {
    position: 20
  } ]
  @UI.lineItem: [
    {
      position: 20
    },
    {
      type: #FOR_ACTION,
      dataAction: 'cancelSelectedOrder',
      label: 'Cancel Selected Order',
      position: 21
    } ]

  @UI.selectionField: [ {
    position: 20
  } ]
  Orderid;

  @UI.identification: [ {
    position: 30
  } ]
  @UI.lineItem: [ {
    position: 30
  } ]
  @UI.selectionField: [ {
    position: 30
  } ]
  OrderDate;

  @UI.identification: [ {
    position: 40
  } ]
  @UI.lineItem: [ {
    position: 40
  } ]
  @UI.selectionField: [ {
    position: 40
  } ]
  OrderTotal;

  @EndUserText.label: 'Discount (%)'
  @UI.identification: [ {
    position: 50,
    label: 'Discount (%)'
  } ]
  @UI.lineItem: [ {
    position: 50,
    label: 'Discount (%)'
  } ]
  @UI.selectionField: [ {
    position: 50
  } ]
  Discount;

  @UI.identification: [ {
    position: 60
  } ]
  @UI.lineItem: [ {
    position: 60
  } ]
  @UI.selectionField: [ {
    position: 60
  } ]
  Info;

  @UI.identification: [ {
  position: 70,
  label: 'Status'
} ]
@UI.lineItem: [ {
  position: 70,
  label: 'Status'
} ]
@UI.selectionField: [ {
  position: 70
} ]
@UI.textArrangement: #TEXT_ONLY
Status;

  @UI.identification: [ {
    position: 80
  } ]
  @UI.lineItem: [ {
    position: 80
  } ]
  @UI.selectionField: [ {
    position: 80
  } ]
  Currency;

  @UI.identification: [ {
    position: 90
  } ]
  @UI.lineItem: [ {
    position: 90
  } ]
  CreatedBy;

  @UI.identification: [ {
    position: 100
  } ]
  @UI.lineItem: [ {
    position: 100
  } ]
  CreatedAt;

  @UI.identification: [ {
    position: 110
  } ]
  @UI.lineItem: [ {
    position: 110
  } ]
  LocalLastChangedBy;

  @UI.identification: [ {
    position: 120
  } ]
  @UI.lineItem: [ {
    position: 120
  } ]
  LocalLastChangedAt;

  @UI.identification: [ {
    position: 130
  } ]
  @UI.lineItem: [ {
    position: 130
  } ]
  LastChangedAt;
}